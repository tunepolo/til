{
	"filters": {
		"whitelist": {
			"allow": [
				"/^\\+{3}[\\s\\S]*?\\+{3}/m",
				"/^{{％[\\s\\S]*?％}}/m"
			]
		},
		"comments": true
	},
	"rules": {
		"preset-ja-technical-writing": {
			"no-mix-dearu-desumasu": {
				"preferInHeader": "",
				"preferInBody": "",
				"preferInList": "である",
				"strict": false
			}
		}
	}
}
